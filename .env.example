# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "development" or "production"
APP_ENV=production

# Comma-separated frontend origins
CORS_ORIGINS=https://your-app-name.herokuapp.com

# sqlite:///resonance.db  OR  postgres://...  (Heroku Postgres connection string)
DATABASE_URL=sqlite:///resonance.db

# Get your token at: https://start.gg/admin/profile/developer
STARTGG_API_KEY=
